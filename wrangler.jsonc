// Cloudflare Workers (static assets + API) config for logan7in.art.
// Same repo and same function code as Netlify; see cloudflare/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logan7in-art",
  "account_id": "ba14a217d31778e1d6d5fbb1a684b1c7",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Netlify functions import "@netlify/blobs"; on Cloudflare that is the D1 shim.
  "alias": { "@netlify/blobs": "./cloudflare/blobs-d1.mjs" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/.netlify/*", "/sketches-meta/*", "/generated-meta/*", "/sketches/json/*"]
  },
  // Netlify Blobs replacement. `wrangler deploy` creates the database on first
  // deploy if database_id is omitted (automatic provisioning).
  "d1_databases": [{ "binding": "DB", "database_name": "logan7in-blobs" }],
  "vars": { "CLOUDFLARE_ACCOUNT_ID": "ba14a217d31778e1d6d5fbb1a684b1c7" },
  "observability": { "enabled": true }
}
